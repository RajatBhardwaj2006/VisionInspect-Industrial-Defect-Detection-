# ====================================================================
# VisionInspect - Environment Configuration Template
# Copy this file to .env and configure as needed.
# ====================================================================

# Environment Mode: 'development' or 'production'
# In production, OpenAPI /docs and /redoc are disabled.
VISIONINSPECT_ENV=production

# Backend REST API URL used by the Streamlit frontend.
# Default local: http://127.0.0.1:8000
VISIONINSPECT_BACKEND_URL=http://127.0.0.1:8000

# Backend Host and Port
VISIONINSPECT_HOST=127.0.0.1
VISIONINSPECT_PORT=8000

# Frontend Host and Port
VISIONINSPECT_FRONTEND_PORT=8501

# Production CORS Allowed Origins (Comma-separated list of origins)
# Example: https://visioninspect.onrender.com,https://your-custom-domain.com
VISIONINSPECT_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Windows PyTorch OpenMP conflict resolution (recommended for Windows CPU)
KMP_DUPLICATE_LIB_OK=TRUE
