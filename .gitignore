# ====================================================================
# VisionInspect - Git Ignore Configuration
# ====================================================================

# Python Virtual Environments
visioninspect_py312/
venv/
.venv/
env/
ENV/

# MVTec AD Dataset (DO NOT COMMIT DATASET)
dataset/
dataset/**
mvtec_anomaly_detection/

# Python Bytecode and Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Environment, Secrets, and Credentials
.env
.env.*
*.pem
*.key

# Logging, Temp Files & Archives
*.log
*.tmp
*.bak
*.old
*.orig
task-*.log
*.zip
*.tar.gz

# Scratch & Temporary Directories
scratch/
temp_pipeline.py
test_env.py
test_env.ipynb

# Model Weights & Memory Banks (Exceeds GitHub 100MB limit; keep local & reproducible via scripts)
*.pt
*.pth
!models/**/.gitkeep
!models/category_prototypes.pt

# OS & Editor Specific
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Runtime Dumps & Temporary Visualizations
results/predictions/
results/comparisons/
results/*_diagnostic/
results/heatmaps/
results/eda/

# Audit Batch Visualizations (Large image dumps kept local; reports tracked; regenerated via scripts/run_audit_batch.py)
results/Updated_model_predictions/**/*.png
